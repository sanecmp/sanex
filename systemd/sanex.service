[Unit]
Description=Sanex digital wellbeing service
After=dbus.service systemd-logind.service network.target
ConditionPathExists=/opt/sanex/config/config.json

[Service]
Type=simple
User=root
Group=root
# Updated packages must remain readable by the user's indicator.
# Private data and logs set their own restrictive permissions.
UMask=0022
RuntimeDirectory=sanex
RuntimeDirectoryMode=0755
WorkingDirectory=/opt/sanex
ExecStart=/opt/sanex/bin/sanex service
Restart=always
RestartSec=10s
TimeoutStopSec=20s
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
# Preserve EUID switching for window agents when systemd installs seccomp filters.
AmbientCapabilities=CAP_SETUID
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
# Hide home directories, but expose session D-Bus and AT-SPI sockets.
ProtectHome=tmpfs
BindReadOnlyPaths=/run/user
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/opt/sanex /var/log/sanex
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
